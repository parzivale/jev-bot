# --- Required ---------------------------------------------------------------
#
# Each secret can be given inline, or as a path to a file containing it.
# The _FILE form wins when both are set, and a trailing newline is stripped.

# Discord bot token: https://discord.com/developers/applications
#   your app -> Bot -> Reset Token
DISCORD_TOKEN=
# DISCORD_TOKEN_FILE=/run/secrets/jev-bot-discord-token

# TypeSafe API key: https://docs.typesafe.ai
TYPESAFE_API_KEY=
# TYPESAFE_API_KEY_FILE=/run/secrets/jev-bot-typesafe-key

# --- Optional (blank or absent is fine) -------------------------------------

# A server ID registers commands there instantly, instead of waiting up to an
# hour for global ones to appear. Right-click a server with Developer Mode on
# -> Copy Server ID.
DISCORD_GUILD_ID=

# Defaults to jev-latest.
TYPESAFE_MODEL=

# Defaults to https://api.typesafe.ai — mainly for tests.
TYPESAFE_BASE_URL=
