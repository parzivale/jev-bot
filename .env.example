# --- Required ---------------------------------------------------------------

# Discord bot token: https://discord.com/developers/applications
#   your app -> Bot -> Reset Token
DISCORD_TOKEN=

# TypeSafe API key: https://docs.typesafe.ai
TYPESAFE_API_KEY=

# --- Optional (blank or absent is fine) -------------------------------------

# A server ID registers /truth there instantly, instead of waiting up to an
# hour for a global command to appear. Right-click a server with Developer Mode
# on -> Copy Server ID.
DISCORD_GUILD_ID=

# Defaults to jev-latest.
TYPESAFE_MODEL=

# Defaults to https://api.typesafe.ai — mainly for tests.
TYPESAFE_BASE_URL=
